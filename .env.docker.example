# Copy to .env.docker, then run:
#   docker compose --env-file .env.docker up -d postgres redis
#
# Note: docker-compose.yml interpolates ${POSTGRES_PORT}/${PGADMIN_PORT}, and the
# `env_file:` key does NOT feed interpolation -- you must pass --env-file.
#
# POSTGRES_* must stay in sync with DATABASE_URL in apps/api/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_research_workspace
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
